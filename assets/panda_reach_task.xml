<mujoco model="panda controlled reach task">
  <!-- Project-owned task wrapper; the included robot asset remains immutable. -->
  <include file="panda.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" rgba="0.16 0.20 0.24 1"/>
    <!-- Position is set at reset through the mocap body; it is never attached to the arm. -->
    <body name="reach_target" mocap="true" pos="0.4 0 0.5">
      <geom name="reach_target_marker" type="sphere" size="0.025" rgba="0.1 0.9 0.2 0.75" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
</mujoco>
